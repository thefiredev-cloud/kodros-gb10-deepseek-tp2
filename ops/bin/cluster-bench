#!/usr/bin/env python3
"""cluster-bench: one-command health + throughput check for the DeepSeek TP2 pair.

    cluster-bench            run the standard bench and compare with the stored baseline
    cluster-bench --save     also store this run as the new baseline
    cluster-bench --json     raw numbers only

Reads the workstation gateway on 127.0.0.1:8080 (path: gateway :8080 -> head :8010 -> engine :8000).
HOSTS are ssh aliases for the two nodes; it reads thermal_zone0 and the GPU temperature on each.
Never changes engine settings, never restarts anything.
"""
import json
import os
import re
import statistics
import subprocess
import sys
import threading
import time
import urllib.request

BASE = "http://127.0.0.1:8080"
MODEL = "DeepSeek-V4.1-Flash-1017-EXL3"
PROMPT = ("Write a Python module named csvutil.py with five functions: read_rows, coerce_types, "
          "dedupe, summarize_columns and write_json. Include type hints, docstrings, error handling "
          "for malformed rows, and a __main__ demo. Output only the code.")
HOSTS = ("spark", "ascent")
STATE = os.path.expanduser("~/ops/state/cluster-bench-baseline.json")
# 2026-10-27 tuned baseline: 8 streams, RDMA nap 2000 us, 1M context
DEFAULT_BASELINE = {"c1": 96.1, "c4": 197.4, "c8": 327.9, "soc_peak": 70.5}


def http(path, payload=None, timeout=60):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(BASE + path, data=data,
                                 headers={"Content-Type": "application/json"} if data else {})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        body = r.read().decode()
    try:
        return json.loads(body)
    except ValueError:
        return body


def chat(max_tokens=600):
    body = {"model": MODEL, "messages": [{"role": "user", "content": PROMPT}],
            "max_tokens": max_tokens, "temperature": 0,
            "chat_template_kwargs": {"enable_thinking": False}}
    t0 = time.time()
    out = http("/v1/chat/completions", body, timeout=400)
    return time.time() - t0, out.get("usage", {}).get("completion_tokens", 0)


def concurrency(n):
    res, lock = [], threading.Lock()

    def w():
        dt, ct = chat()
        with lock:
            res.append((dt, ct))

    ts = [threading.Thread(target=w) for _ in range(n)]
    t0 = time.time()
    [t.start() for t in ts]
    [t.join() for t in ts]
    wall = time.time() - t0
    return sum(c for _, c in res) / wall, sum(c for _, c in res), wall


def temps():
    cmd = ("printf '%s %s' \"$(cat /sys/class/thermal/thermal_zone0/temp)\" "
           "\"$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader)\"")
    out = {}
    for host in HOSTS:
        try:
            r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", host, cmd],
                               capture_output=True, text=True, timeout=20)
            soc, gpu = r.stdout.split()
            out[host] = (int(soc) / 1000, int(gpu))
        except Exception:
            out[host] = (None, None)
    return out


def main():
    save = "--save" in sys.argv
    as_json = "--json" in sys.argv

    health = http("/health")
    models = http("/v1/models")
    loaded = models["data"][0]["id"] if models.get("data") else None
    if not health.get("vllm_up") or loaded != MODEL:
        print(f"DOWN: proxy={health.get('proxy')} engine_up={health.get('vllm_up')} loaded={loaded}")
        return 2

    rates = []
    for _ in range(3):
        dt, ct = chat()
        rates.append(ct / dt)
    c1_rate = statistics.median(rates)
    c4, _, _ = concurrency(4)
    c8, _, _ = concurrency(8)
    t = temps()
    soc_peak = max(v[0] for v in t.values() if v[0])

    try:
        baseline = json.load(open(STATE))
    except Exception:
        baseline = DEFAULT_BASELINE
    now = {"c1": c1_rate, "c4": c4, "c8": c8, "soc_peak": soc_peak,
           "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    if save:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        json.dump(now, open(STATE, "w"), indent=1)
    if as_json:
        print(json.dumps(now))
        return 0

    print(f"engine {loaded} up; ran {time.strftime('%H:%M:%SZ', time.gmtime())}")
    for key, label, lower_better in (("c1", "c1 decode", False), ("c4", "c4 aggregate", False),
                                     ("c8", "c8 aggregate", False), ("soc_peak", "SoC peak", True)):
        base = baseline.get(key)
        delta = (now[key] - base) / base * 100 if base else 0
        unit = "C" if key == "soc_peak" else "tok/s"
        flag = ""
        if abs(delta) >= 3:
            good = delta < 0 if lower_better else delta > 0
            flag = " better" if good else " REGRESSION"
        print(f"  {label:<13} {now[key]:7.1f} {unit:<6} vs {base:7.1f}  {delta:+5.1f}%{flag}")
    print("  temps       " + "  ".join(
        f"{h}: {soc:.1f}C soc/{gpu}C gpu" for h, (soc, gpu) in t.items() if soc))
    if save:
        print(f"  baseline saved to {STATE}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
